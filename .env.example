# Copia este archivo como .env y cambia los valores. NO subas .env a Git.
DERMA_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-caracteres-o-mas
DERMA_SESSION_MINUTES=60
DERMA_MAX_UPLOAD_MB=5
DERMA_USERS_DB=data/usuarios.db
DERMA_CATALOG_DB=data/catalogo.db
DERMA_MODEL_PATH=models/dermaai_mobilenetv2_v1.keras
# true solo cuando se publique con HTTPS; en local (http) debe ser false
DERMA_COOKIE_SECURE=false
# Usuario de demostración (opcional): se crea al arrancar si no existe
DERMA_DEMO_EMAIL=
DERMA_DEMO_PASSWORD=
